{
  "manifest_version": 3,
  "name": "Let's Pick",
  "short_name": "Let's Pick",
  "version": "1.5.0",
  "description": "사용자가 분석을 시작한 현재 사이트에서만 이미지·영상·SVG·글꼴 원본과 디자인 토큰을 찾는 Let's Pick.",
  "permissions": [
    "contextMenus",
    "webRequest",
    "storage",
    "scripting",
    "downloads",
    "tabs",
    "activeTab"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Let's Pick — 이미지·영상·SVG 원본 찾기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "inspect-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "마우스가 올라간 이미지·영상 분석 (없으면 페이지 전체 보기)"
    },
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "이 페이지의 미디어를 패널로 모두 보기"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  }
}
